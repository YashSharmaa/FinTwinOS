{
  "$defs": {
    "EntityRef": {
      "description": "A typed pointer to a canonical entity in the twin.",
      "properties": {
        "entity_type": {
          "title": "Entity Type",
          "type": "string"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        }
      },
      "required": [
        "entity_type",
        "entity_id"
      ],
      "title": "EntityRef",
      "type": "object"
    },
    "Provenance": {
      "description": "Where a record came from and how it can be traced back.",
      "properties": {
        "source_system": {
          "title": "Source System",
          "type": "string"
        },
        "ingested_at": {
          "format": "date-time",
          "title": "Ingested At",
          "type": "string"
        },
        "record_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Hash"
        },
        "licence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licence"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "source_system"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "description": "The single ingestion unit. Every connector emits these; the twin consumes them.",
  "properties": {
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "kind": {
      "title": "Kind",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/EntityRef"
      },
      "title": "Entities",
      "type": "array"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "episode_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Episode Id"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Provenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "kind",
    "source"
  ],
  "title": "EventEnvelope",
  "type": "object"
}
