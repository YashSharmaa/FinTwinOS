{
  "$defs": {
    "Provenance": {
      "description": "Where a record came from and how it can be traced back.",
      "properties": {
        "source_system": {
          "title": "Source System",
          "type": "string"
        },
        "ingested_at": {
          "format": "date-time",
          "title": "Ingested At",
          "type": "string"
        },
        "record_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Hash"
        },
        "licence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licence"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "source_system"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "description": "Uniform return type of every tool call routed through the registry.",
  "properties": {
    "ok": {
      "title": "Ok",
      "type": "boolean"
    },
    "tool": {
      "title": "Tool",
      "type": "string"
    },
    "data": {
      "default": null,
      "title": "Data"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "title": "Provenance",
      "type": "array"
    },
    "audit_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audit Ref"
    },
    "requires_approval": {
      "default": false,
      "title": "Requires Approval",
      "type": "boolean"
    },
    "elapsed_ms": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Elapsed Ms"
    }
  },
  "required": [
    "ok",
    "tool"
  ],
  "title": "ToolResult",
  "type": "object"
}
