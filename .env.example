# FinTwinOS configuration — copy to .env and fill in.
# All FINTWIN_* variables are optional; sensible defaults apply.

# --- LLM provider (OpenAI) ---------------------------------------------------
OPENAI_API_KEY=
FINTWIN_LLM_MODEL_PRIMARY=gpt-5
FINTWIN_LLM_MODEL_FAST=gpt-5-mini
FINTWIN_LLM_MODEL_CHEAP=gpt-5-nano
# Reasoning effort for gpt-5 / o-series models (minimal|low|medium|high).
FINTWIN_LLM_REASONING_EFFORT=low
# Hard per-process spend ceiling in USD; the client refuses calls past it. 0 disables.
FINTWIN_LLM_BUDGET_USD=25.0
# Content-addressed response cache under <data_dir>/llm_cache (identical prompts are free).
FINTWIN_LLM_CACHE_ENABLED=1

# --- Runtime -------------------------------------------------------------------
# Set to 1 to run fully offline with deterministic LLM stubs (no key needed).
FINTWIN_OFFLINE=0
FINTWIN_SEED=7
FINTWIN_DATA_DIR=.fintwinos
FINTWIN_ENVIRONMENT=local
# Persist the hash-chained audit trail as JSONL (in-memory when unset).
FINTWIN_AUDIT_PATH=.fintwinos/audit.jsonl

# --- Governance (defaults are deliberately conservative) -----------------------
# The execute tool band is OFF unless explicitly enabled — and even then every
# execute call needs a policy allow-rule plus a human approval token.
FINTWIN_EXECUTE_TOOLS_ENABLED=0
FINTWIN_DUAL_CONTROL_REQUIRED=1
# Shadow mode: execute calls pass every gate but are intercepted before the
# handler runs — decisions are logged and compared, never acted on.
FINTWIN_SHADOW_MODE=1
# HMAC key for approval tokens. When set, the registry refuses any token that
# was not minted (signed) by the ApprovalWorkflow under the same secret.
FINTWIN_APPROVAL_SECRET=
# Role assumed for tool calls that assert none (viewer|analyst|approver|operator|admin).
FINTWIN_RBAC_DEFAULT_ROLE=analyst
# Bearer token required by the webhook ingestion router (unauthenticated when unset).
FINTWIN_WEBHOOK_TOKEN=
