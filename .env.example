# FinTwinOS configuration — copy to .env and fill in.
# All FINTWIN_* variables are optional; sensible defaults apply.

# --- LLM provider (OpenAI) ---------------------------------------------------
OPENAI_API_KEY=
FINTWIN_LLM_MODEL_PRIMARY=gpt-5
FINTWIN_LLM_MODEL_FAST=gpt-5-mini
FINTWIN_LLM_MODEL_CHEAP=gpt-5-nano

# --- Runtime -------------------------------------------------------------------
# Set to 1 to run fully offline with deterministic LLM stubs (no key needed).
FINTWIN_OFFLINE=0
FINTWIN_SEED=7
FINTWIN_DATA_DIR=.fintwinos
FINTWIN_ENVIRONMENT=local

# --- Governance (defaults are deliberately conservative) -----------------------
# The execute tool band is OFF unless explicitly enabled — and even then every
# execute call needs a policy allow-rule plus a human approval token.
FINTWIN_EXECUTE_TOOLS_ENABLED=0
FINTWIN_DUAL_CONTROL_REQUIRED=1
FINTWIN_SHADOW_MODE=1
