# Keep the Docker build context minimal: the image only needs pyproject.toml,
# README.md, LICENSE and the fintwinos/ package (see infra/Dockerfile). Most
# importantly, never ship the virtualenv, git history, local twin state or any
# .env file that could carry an API key into the build context.

# Virtual environments and interpreters
.venv/
venv/
.python-version

# Version control and CI metadata
.git/
.github/
.gitignore

# Secrets and local configuration — NEVER allow these into the context
.env
.env.*
*.pem
*.key

# FinTwinOS local state (audit chains, outbox, eval reports)
.fintwinos/
*.audit.jsonl

# Python build artefacts and caches
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Data caches (never bake privileged data into an image)
datasets/cache/
datasets/raw/
*.parquet

# Repo content the wheel build does not need
tests/
docs/
examples/
schemas/
infra/
Makefile
*.md
!README.md

# OS / editor noise
.DS_Store
.idea/
.vscode/
.claude/
